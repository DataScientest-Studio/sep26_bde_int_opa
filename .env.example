# Copy this file to .env and adjust if needed. Never commit .env.

# PostgreSQL (silver + gold)
POSTGRES_USER=opa
POSTGRES_PASSWORD=opa_password
POSTGRES_DB=opa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB (bronze)
MONGO_USER=opa
MONGO_PASSWORD=opa_password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=opa
MONGO_COLLECTION=raw_klines

# Binance
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
SYMBOLS=BTCUSDT,SOLUSDT
REST_INTERVAL=15m
WS_INTERVAL=1m
HISTORY_DAYS=180
